{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ReviewHub": "Data Source=reviewhub.db"
  },
  "Database": {
    "ResetOnStartup": true
  },
  "ReviewRouting": {
    "DefaultLeaseHours": 4,
    "MaxAuthorOpenReviewsBeforeWarning": 3,
    "LeaseCheckIntervalSeconds": 60
  },
  "Queue": {
    "WaitingHours": 4,
    "AgingHours": 8,
    "StaleHours": 24,
    "CriticalHours": 48
  },
  "Priority": {
    "HighBandThreshold": 35,
    "MediumBandThreshold": 20
  },
  "ReviewSurface": {
    "MeaningfulLineThreshold": 600,
    "ProductionFileThreshold": 15
  },
  "SourceControl": {
    "Provider": "Mock"
  },
  "ReviewBrief": {
    "Provider": "Mock"
  }
}
